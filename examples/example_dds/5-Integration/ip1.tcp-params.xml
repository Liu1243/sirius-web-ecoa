<?xml version="1.0" encoding="UTF-8"?>
<!--
  TCP transport parameters for link: link_Writer_to_Reader
  Protocol: TCP (ELI over TCP)
  Referenced by cs1.logical-system.xml:
    <transportBinding protocol="TCP" parameters="ip1.tcp-params.xml"/>

  Each platform acts as both server (listens on its own port) and client
  (connects to the other platform) at startup.
-->
<TCPBinding xmlns="http://www.ecoa.technology/tcpbinding">

  <!-- Platform_Writer: machine running compWriter -->
  <platform name="Platform_Writer" address="192.168.1.120" port="30000"/>

  <!-- Platform_Reader: machine running compReader0/1 and compFinisher -->
  <platform name="Platform_Reader" address="192.168.1.121" port="30001"/>

</TCPBinding>
