<?xml version="1.0" encoding="UTF-8"?>
<deployment xmlns="http://www.ecoa.technology/deployment-2.0"
            finalAssembly="demo" logicalSystem="cs1">

  <!-- compWriter runs on Platform_Writer -->
  <protectionDomain name="Writer_PD">
    <executeOn computingNode="machine_writer" computingPlatform="Platform_Writer"/>
    <deployedModuleInstance componentName="compWriter"
      moduleInstanceName="myCompWriter_mod_inst0"       modulePriority="30"/>
    <deployedModuleInstance componentName="compWriter"
      moduleInstanceName="myCompWriter_mod_inst1"       modulePriority="30"/>
    <deployedModuleInstance componentName="compWriter"
      moduleInstanceName="myCompWriter_write_only_inst" modulePriority="30"/>
  </protectionDomain>

  <!-- compReader0, compReader1, compFinisher run on Platform_Reader -->
  <protectionDomain name="Reader_PD">
    <executeOn computingNode="machine_reader" computingPlatform="Platform_Reader"/>
    <deployedModuleInstance componentName="compReader0"
      moduleInstanceName="myCompReader_mod_inst0" modulePriority="30"/>
    <deployedModuleInstance componentName="compReader0"
      moduleInstanceName="myCompReader_mod_inst1" modulePriority="30"/>
    <deployedModuleInstance componentName="compReader1"
      moduleInstanceName="myCompReader_mod_inst0" modulePriority="30"/>
    <deployedModuleInstance componentName="compReader1"
      moduleInstanceName="myCompReader_mod_inst1" modulePriority="30"/>
    <deployedModuleInstance componentName="compFinisher"
      moduleInstanceName="myCompFinisher_mod_inst" modulePriority="30"/>
  </protectionDomain>

  <!--
    Cross-platform wire mappings (3 wires cross the platform boundary).
    All three are carried by the same TCP link: link_Writer_to_Reader.

    Intra-platform wires on Platform_Reader (no mapping needed):
      compReader0/svc_finish → compFinisher/finish_interface
      compReader1/svc_finish → compFinisher/finish_interface
  -->
  <wireMapping source="compReader0/svc_reader"
               target="compWriter/svc_writer"
               mappedOnLinkId="link_Writer_to_Reader"/>

  <wireMapping source="compReader1/svc_reader"
               target="compWriter/svc_writer"
               mappedOnLinkId="link_Writer_to_Reader"/>

  <wireMapping source="compWriter/svc_finish"
               target="compFinisher/finish_interface"
               mappedOnLinkId="link_Writer_to_Reader"/>

  <platformConfiguration computingPlatform="Platform_Writer"
                         faultHandlerNotificationMaxNumber="8">
    <computingNodeConfiguration computingNode="machine_writer"/>
  </platformConfiguration>

  <platformConfiguration computingPlatform="Platform_Reader"
                         faultHandlerNotificationMaxNumber="8">
    <computingNodeConfiguration computingNode="machine_reader"/>
  </platformConfiguration>

</deployment>
