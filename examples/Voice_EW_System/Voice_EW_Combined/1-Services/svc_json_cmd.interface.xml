<?xml version="1.0" encoding="UTF-8"?>
<!--
  JSON 控制指令服务: 大模型 -> 语音管理服务 (功能(2))
  大模型将 XXX 应用的语音控制消息解析为与 struct1 对应的 JSON,
  携带 topicID 发送给语音管理服务; 语音管理服务按 topicID 查找 struct1 并据此修改。
-->
<serviceDefinition xmlns="http://www.ecoa.technology/interface-2.0">
  <use library="Common_lib"/>
  <operations>
    <event name="json_control" direction="RECEIVED_BY_PROVIDER">
      <input name="topic_id" type="ECOA:uint16"/>
      <input name="payload" type="Common_lib:json_text"/>
    </event>
  </operations>
</serviceDefinition>

