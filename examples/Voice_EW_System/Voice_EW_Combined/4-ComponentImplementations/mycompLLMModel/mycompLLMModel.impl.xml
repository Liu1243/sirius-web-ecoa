<?xml version="1.0" encoding="UTF-8"?>
<componentImplementation xmlns="http://www.ecoa.technology/implementation-2.0" componentDefinition="LLMModel">
  <use library="Common_lib"/>

  <moduleType name="myLLMModel_mod_t">
    <operations>
      <!-- 功能(2): 接收 XXX 应用语音控制消息 -->
      <eventReceived name="voice_control">
        <input name="voice_content" type="Common_lib:voice_msg"/>
      </eventReceived>
      <!-- 功能(3): 接收 XXX 应用语音查询消息 -->
      <eventReceived name="voice_query">
        <input name="voice_content" type="Common_lib:voice_msg"/>
      </eventReceived>
      <!-- 功能(2): 语音解析为带 topicID 的 JSON, 发送给语音管理服务 -->
      <eventSent name="json_control">
        <input name="topic_id" type="ECOA:uint16"/>
        <input name="payload" type="Common_lib:json_text"/>
      </eventSent>
      <!-- 功能(3): 向语音管理服务查询 struct2 对应的 JSON -->
      <requestSent name="query_versioned_json" timeout="5.0" isSynchronous="false">
        <output name="payload" type="Common_lib:json_text"/>
      </requestSent>
    </operations>
  </moduleType>

  <moduleImplementation language="C++" moduleType="myLLMModel_mod_t" name="myLLMModel_mod"/>
  <moduleInstance name="myLLMModel_mod_inst" relativePriority="100" implementationName="myLLMModel_mod"/>

  <!-- 功能(2)(3): 语音消息, 服务(来自 XXX 应用) -> 模块 -->
  <eventLink>
    <senders>
      <service instanceName="svc_voice_msg" operationName="voice_control"/>
    </senders>
    <receivers>
      <moduleInstance instanceName="myLLMModel_mod_inst" operationName="voice_control" fifoSize="8"/>
    </receivers>
  </eventLink>
  <eventLink>
    <senders>
      <service instanceName="svc_voice_msg" operationName="voice_query"/>
    </senders>
    <receivers>
      <moduleInstance instanceName="myLLMModel_mod_inst" operationName="voice_query" fifoSize="8"/>
    </receivers>
  </eventLink>

  <!-- 功能(2): JSON 控制指令, 模块 -> 引用(发往语音管理服务) -->
  <eventLink>
    <senders>
      <moduleInstance instanceName="myLLMModel_mod_inst" operationName="json_control"/>
    </senders>
    <receivers>
      <reference instanceName="svc_json_cmd" operationName="json_control"/>
    </receivers>
  </eventLink>

  <!-- 功能(3): struct2 JSON 查询, 模块 -> 引用(发往语音管理服务) -->
  <requestLink>
    <clients>
      <moduleInstance instanceName="myLLMModel_mod_inst" operationName="query_versioned_json"/>
    </clients>
    <server>
      <reference instanceName="svc_vd_query" operationName="query_versioned_json"/>
    </server>
  </requestLink>

</componentImplementation>

