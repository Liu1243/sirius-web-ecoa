<?xml version="1.0" encoding="UTF-8"?>
<deployment xmlns="http://www.ecoa.technology/deployment-2.0"
            finalAssembly="demo" logicalSystem="cs1">

  <!-- YYY 应用全部模块部署在 Platform_YYY -->
  <protectionDomain name="YYY_PD">
    <executeOn computingNode="machine_yyy" computingPlatform="Platform_YYY"/>
    <deployedModuleInstance componentName="compYYYDevice"
      moduleInstanceName="myYYYDevice_mod_inst" modulePriority="30"/>
    <deployedTriggerInstance componentName="compYYYDevice"
      triggerInstanceName="publish_timer" triggerPriority="10"/>
  </protectionDomain>

  <platformConfiguration computingPlatform="Platform_YYY"
                         faultHandlerNotificationMaxNumber="8">
    <computingNodeConfiguration computingNode="machine_yyy"/>
  </platformConfiguration>

</deployment>

