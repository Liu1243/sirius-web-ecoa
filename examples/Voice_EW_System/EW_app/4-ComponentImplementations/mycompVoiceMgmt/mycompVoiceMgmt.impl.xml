<?xml version="1.0" encoding="UTF-8"?>
<componentImplementation xmlns="http://www.ecoa.technology/implementation-2.0" componentDefinition="VoiceManagement">
  <use library="Common_lib"/>

  <moduleType name="myVoiceMgmt_mod_t">
    <operations>
      <!-- 功能(1): 订阅 YYY 应用的版本化数据 struct2, notifying=true 数据更新即激活, 实时缓存 -->
      <dataRead name="versioned_data_in" type="Common_lib:versioned_data" notifying="true"/>
      <!-- 功能(2): 发布修改后的事件数据 struct1, 经中间件发送给 YYY 应用 -->
      <dataWritten name="event_data_out" type="Common_lib:event_data"/>
      <!-- 功能(2): 接收大模型解析出的带 topicID 的 JSON 控制指令 -->
      <eventReceived name="json_control">
        <input name="topic_id" type="ECOA:uint16"/>
        <input name="payload" type="Common_lib:json_text"/>
      </eventReceived>
      <!-- 功能(3): 应答大模型对 struct2 对应 JSON 的查询 -->
      <requestReceived name="query_versioned_json">
        <output name="payload" type="Common_lib:json_text"/>
      </requestReceived>
    </operations>
  </moduleType>

  <moduleImplementation language="C" moduleType="myVoiceMgmt_mod_t" name="myVoiceMgmt_mod"/>
  <moduleInstance name="myVoiceMgmt_mod_inst" relativePriority="100" implementationName="myVoiceMgmt_mod"/>

  <!-- 功能(1): 版本化数据 struct2, 引用(来自中间件) -> 模块, 缓存并据此修改 struct1 -->
  <dataLink>
    <writers>
      <reference instanceName="svc_versioned_data" operationName="versioned_data"/>
    </writers>
    <readers>
      <moduleInstance instanceName="myVoiceMgmt_mod_inst" operationName="versioned_data_in"/>
    </readers>
  </dataLink>

  <!-- 功能(2): 修改后的事件数据 struct1, 模块 -> 服务(经中间件发往 YYY 应用) -->
  <dataLink>
    <writers>
      <moduleInstance instanceName="myVoiceMgmt_mod_inst" operationName="event_data_out"/>
    </writers>
    <readers>
      <service instanceName="svc_event_data" operationName="event_data"/>
    </readers>
  </dataLink>

  <!-- 功能(2): JSON 控制指令, 服务(来自大模型) -> 模块 -->
  <eventLink>
    <senders>
      <service instanceName="svc_json_cmd" operationName="json_control"/>
    </senders>
    <receivers>
      <moduleInstance instanceName="myVoiceMgmt_mod_inst" operationName="json_control" fifoSize="8"/>
    </receivers>
  </eventLink>

  <!-- 功能(3): struct2 JSON 查询, 服务(来自大模型) -> 模块 -->
  <requestLink>
    <clients>
      <service instanceName="svc_vd_query" operationName="query_versioned_json"/>
    </clients>
    <server>
      <moduleInstance instanceName="myVoiceMgmt_mod_inst" operationName="query_versioned_json"/>
    </server>
  </requestLink>

</componentImplementation>

