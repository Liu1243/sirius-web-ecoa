<?xml version="1.0" encoding="UTF-8"?>
<!--
  版本化数据查询服务: 大模型 -> 语音管理服务 (功能(3))
  XXX 应用发出语音查询消息后, 大模型通过该服务从语音管理服务
  获取缓存的 struct2 所对应的 JSON 文件。
-->
<serviceDefinition xmlns="http://www.ecoa.technology/interface-2.0">
  <use library="Common_lib"/>
  <operations>
    <requestresponse name="query_versioned_json">
      <output name="payload" type="Common_lib:json_text"/>
    </requestresponse>
  </operations>
</serviceDefinition>

