<?xml version="1.0" encoding="UTF-8"?>
<!--
  语音消息服务: XXX 应用 -> 大模型
  voice_control: 语音控制消息(功能(2)), 大模型解析为与 struct1 对应的 JSON
  voice_query:   语音查询消息(功能(3)), 大模型据此向语音管理服务查询 struct2 的 JSON
-->
<serviceDefinition xmlns="http://www.ecoa.technology/interface-2.0">
  <use library="Common_lib"/>
  <operations>
    <event name="voice_control" direction="RECEIVED_BY_PROVIDER">
      <input name="voice_content" type="Common_lib:voice_msg"/>
    </event>
    <event name="voice_query" direction="RECEIVED_BY_PROVIDER">
      <input name="voice_content" type="Common_lib:voice_msg"/>
    </event>
  </operations>
</serviceDefinition>

