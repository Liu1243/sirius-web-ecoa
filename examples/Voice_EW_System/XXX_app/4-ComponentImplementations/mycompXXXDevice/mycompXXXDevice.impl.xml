<?xml version="1.0" encoding="UTF-8"?>
<componentImplementation xmlns="http://www.ecoa.technology/implementation-2.0" componentDefinition="XXXDevice">
  <use library="Common_lib"/>

  <moduleType name="myXXXDevice_mod_t">
    <operations>
      <!-- 语音控制消息: 改变 YYY 设备状态 (功能(2)) -->
      <eventSent name="voice_control">
        <input name="voice_content" type="Common_lib:voice_msg"/>
      </eventSent>
      <!-- 语音查询消息: 发送 YYY 设备的查询指令 (功能(3)) -->
      <eventSent name="voice_query">
        <input name="voice_content" type="Common_lib:voice_msg"/>
      </eventSent>
      <!-- 语音采集触发 -->
      <eventReceived name="trigger_voice"/>
    </operations>
  </moduleType>

  <moduleImplementation language="C++" moduleType="myXXXDevice_mod_t" name="myXXXDevice_mod"/>
  <moduleInstance name="myXXXDevice_mod_inst" relativePriority="100" implementationName="myXXXDevice_mod"/>
  <triggerInstance name="voice_timer" relativePriority="0"/>

  <!-- 周期触发语音消息发送(模拟语音采集/识别输入) -->
  <eventLink>
    <senders>
      <trigger instanceName="voice_timer" period="10"/>
    </senders>
    <receivers>
      <moduleInstance instanceName="myXXXDevice_mod_inst" operationName="trigger_voice"/>
    </receivers>
  </eventLink>

  <!-- 语音控制消息: 模块 -> 引用(经中间件发往电子自卫应用大模型) -->
  <eventLink>
    <senders>
      <moduleInstance instanceName="myXXXDevice_mod_inst" operationName="voice_control"/>
    </senders>
    <receivers>
      <reference instanceName="svc_voice_msg" operationName="voice_control"/>
    </receivers>
  </eventLink>

  <!-- 语音查询消息: 模块 -> 引用(经中间件发往电子自卫应用大模型) -->
  <eventLink>
    <senders>
      <moduleInstance instanceName="myXXXDevice_mod_inst" operationName="voice_query"/>
    </senders>
    <receivers>
      <reference instanceName="svc_voice_msg" operationName="voice_query"/>
    </receivers>
  </eventLink>

</componentImplementation>

