<?xml version="1.0" encoding="UTF-8"?>
<deployment finalAssembly="demo" logicalSystem="cs1"
  xmlns="http://www.ecoa.technology/deployment-2.0">

  <!-- Ping 组件部署在 Platform_Ping -->
  <protectionDomain name="Ping_PD">
    <executeOn computingNode="machine_ping" computingPlatform="Platform_Ping"/>
    <deployedModuleInstance componentName="demoPing"
      moduleInstanceName="myDemoPing_AM_I"  modulePriority="30"/>
    <deployedModuleInstance componentName="demoPing"
      moduleInstanceName="myDemoPong2_AM_I" modulePriority="30"/>
    <deployedModuleInstance componentName="demoPing"
      moduleInstanceName="myDemoPong3_AM_I" modulePriority="30"/>
    <deployedTriggerInstance componentName="demoPing"
      triggerInstanceName="Heart_Beat" triggerPriority="10"/>
  </protectionDomain>

  <!-- Pong 组件部署在 Platform_Pong -->
  <protectionDomain name="Pong_PD">
    <executeOn computingNode="machine_pong" computingPlatform="Platform_Pong"/>
    <deployedModuleInstance componentName="demoPong"
      moduleInstanceName="myDemoPong_AM_I" modulePriority="30"/>
  </protectionDomain>

  <!-- 将跨平台 wire 映射到 UDP 链路 -->
  <wireMapping source="demoPing/PingPong"
               target="demoPong/PingPong"
               mappedOnLinkId="link_Ping_to_Pong"/>

  <platformConfiguration computingPlatform="Platform_Ping"
                         faultHandlerNotificationMaxNumber="8">
    <computingNodeConfiguration computingNode="machine_ping"/>
  </platformConfiguration>

  <platformConfiguration computingPlatform="Platform_Pong"
                         faultHandlerNotificationMaxNumber="8">
    <computingNodeConfiguration computingNode="machine_pong"/>
  </platformConfiguration>

</deployment>
