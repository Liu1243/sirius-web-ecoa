<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">
    <changeSet id="04-unique-project-name" author="obeo">
        <!-- Deduplicate "EmptyProject" entries (default name from new-project UI)
             before adding the unique constraint.  Keep the oldest record and rename
             newer duplicates by appending the first 8 chars of their UUID. -->
        <sql>
            UPDATE project
            SET name = name || '-' || substring(id::text, 1, 8)
            WHERE name IN (
                SELECT name FROM project GROUP BY name HAVING count(*) > 1
            )
            AND id NOT IN (
                SELECT min(id) FROM project GROUP BY name HAVING count(*) > 1
            );
        </sql>
        <addUniqueConstraint
                tableName="project"
                columnNames="name"
                constraintName="uq_project_name" />
    </changeSet>
</databaseChangeLog>
