# ── Git ──────────────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── IDE / 编辑器 ──────────────────────────────────────────────────────
.idea/
.vscode/
.cursor/
*.iml

# ── 运行时生成的日志 / 输出 / 上传（不需要打入镜像）──────────────────────
logs/
outputs/
uploads/

# ── 测试文件 ──────────────────────────────────────────────────────────
test_*.py
*_test.py

# ── 文档 ─────────────────────────────────────────────────────────────
doc/
docs/
*.md
*.adoc
*.pdf
*.docx

# ── 临时文件 / 缓存 ───────────────────────────────────────────────────
*.log
*.pyc
**/*.pyc
__pycache__/
**/__pycache__/
*.egg-info
*.egg-info/
**/*.egg-info
**/*.egg-info/
.pytest_cache/
**/.pytest_cache/
.turbo/

# ── 开发工具配置（运行时不需要）──────────────────────────────────────────
flake.nix
flake.lock
launch.json
Makefile
check_container_logs.sh

